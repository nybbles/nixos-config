{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 2,
  "final_space": true,
  "console_title_template": {% raw %}"{{ .Shell }} in {{ .Folder }}"{% endraw %},
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "path",
          "style": "powerline",
          "powerline_symbol": "\uE0B0",
          "foreground": "{{background}}",
          "background": "{{color4}}",
          "template": {% raw %}" \uE5FF {{ .Path }} "{% endraw %},
          "properties": {
            "style": "folder"
          }
        },
        {
          "type": "git",
          "style": "powerline",
          "powerline_symbol": "\uE0B0",
          "foreground": "{{background}}",
          "background": "{{color2}}",
          "background_templates": [
            "{% raw %}{{ if or (.Working.Changed) (.Staging.Changed) }}{% endraw %}{{color3}}{% raw %}{{ end }}{% endraw %}",
            "{% raw %}{{ if and (gt .Ahead 0) (gt .Behind 0) }}{% endraw %}{{color1}}{% raw %}{{ end }}{% endraw %}",
            "{% raw %}{{ if gt .Ahead 0 }}{% endraw %}{{color5}}{% raw %}{{ end }}{% endraw %}",
            "{% raw %}{{ if gt .Behind 0 }}{% endraw %}{{color9}}{% raw %}{{ end }}{% endraw %}"
          ],
          "template": {% raw %}" {{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uF044 {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }} \uF046 {{ .Staging.String }}{{ end }} "{% endraw %},
          "properties": {
            "branch_max_length": 25,
            "fetch_status": true,
            "fetch_upstream_icon": true
          }
        },
        {
          "type": "executiontime",
          "style": "powerline",
          "powerline_symbol": "\uE0B0",
          "foreground": "{{background}}",
          "background": "{{color13}}",
          "template": {% raw %}" \uFA1E {{ .FormattedMs }} "{% endraw %},
          "properties": {
            "threshold": 500
          }
        }
      ]
    },
    {
      "type": "rprompt",
      "segments": [
        {
          "type": "node",
          "style": "plain",
          "foreground": "{{color2}}",
          "template": {% raw %}"\uE718 {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }}"{% endraw %},
          "properties": {
            "fetch_version": true
          }
        },
        {
          "type": "python",
          "style": "plain",
          "foreground": "{{color3}}",
          "template": {% raw %}"\uE235 {{ if .Error }}{{ .Error }}{{ else }}{{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }}{{ end }}"{% endraw %},
          "properties": {
            "display_mode": "files",
            "fetch_virtual_env": false
          }
        },
        {
          "type": "time",
          "style": "plain",
          "foreground": "{{color6}}",
          "template": {% raw %}" \uF5EF {{ .CurrentDate | date .Format }} "{% endraw %}
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "{{color5}}",
          "template": "❯ "
        }
      ]
    }
  ]
}
